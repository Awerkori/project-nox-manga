{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manga",
  "main": "src/worker-wrapper.js",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "routes": [
    { "pattern": "projectnox.org", "custom_domain": true },
    { "pattern": "www.projectnox.org", "custom_domain": true }
  ],
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS",
    "run_worker_first": false,
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "off"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "83726ad935554261813c4bb12094c7f3"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "COVER_THUMBNAILS",
      "id": "cfcadf7da6f446dd851786d833a2f4ec"
    }
  ]
}
