{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manga",
  "main": "src/worker-wrapper.js",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "routes": [
    { "pattern": "projectnox.org", "custom_domain": true },
    { "pattern": "www.projectnox.org", "custom_domain": true }
  ],
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS",
    "run_worker_first": false,
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NOX_ENVIRONMENT": "production",
    "PREVIEW_ISOLATED": "false"
  },
  "placement": {
    "mode": "off"
  },
  "ratelimits": [
    { "name": "AUTH_ORIGIN_RATE_LIMIT", "namespace_id": "2147034101", "simple": { "limit": 40, "period": 60 } },
    { "name": "AUTH_IDENTITY_RATE_LIMIT", "namespace_id": "2147034102", "simple": { "limit": 6, "period": 60 } },
    { "name": "COMMENT_POST_RATE_LIMITER", "namespace_id": "2147034103", "simple": { "limit": 2, "period": 60 } }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "83726ad935554261813c4bb12094c7f3",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/postgres"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "COVER_THUMBNAILS",
      "id": "cfcadf7da6f446dd851786d833a2f4ec"
    }
  ]
}
