{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manga",
  "main": "src/worker-wrapper.js",
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "region": "aws:sa-east-1"
  }
}