          <label for="report_reason" class="form-label">Motivo da denncia *</label>
          <textarea
            id="report_reason"
            name="reason"
            rows="3"
            required
            maxlength="500"
            bind:value={reportReason}
            placeholder="Descreva o motivo (ex: spam, assdio, spoiler sem aviso, contedo ofensivo)..."
