                  >
                    <Smile size={14} />
                  </button>

                  <button
                    type="button"
                    class="hover-action-btn"
                    title="Responder"
                    onclick={() => {
                      replyingTo = msg;
                      if (textareaEl) textareaEl.focus();
                    }}
                  >
                    <CornerDownRight size={14} />
                  </button>

                  <button
                    type="button"
                    class="hover-action-btn"
