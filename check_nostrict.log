                    <!-- Quick Claim Button in Header -->
                    <form
                      method="POST"
                      action="?/claimStage"
                      use:enhance={() => {
                        isClaimingStageId = item.cs.id;
                        return async ({ result, update }) => {
                          isClaimingStageId = null;
                          if (result.type === 'failure') {
                            claimFeedback = {
                              stageId: item.cs.id,
                              type: 'error',
                              text: result.data?.message || 'Este captulo acabou de ser pego por outro membro.'
                            };
