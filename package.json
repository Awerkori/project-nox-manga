{
  "name": "project-nox-manga",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "^0.7.2"
    }
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "postbuild": "node scripts/retain-client-assets.mjs restore && node scripts/inject-worker-auth-bypass.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:browser": "playwright test --config playwright.components.config.ts",
    "deploy": "wrangler deploy",
    "prebuild": "node scripts/retain-client-assets.mjs save"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@libsql/client-wasm": "^0.18.0",
    "@lucide/svelte": "latest",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.5",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "fflate": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@sveltejs/adapter-cloudflare": "latest",
    "@sveltejs/kit": "latest",
    "@sveltejs/vite-plugin-svelte": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "eslint-plugin-svelte": "latest",
    "globals": "latest",
    "miniflare": "5.20260903.0-alpha",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "latest",
    "svelte-check": "latest",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260903.1": true
  }
}
