              >
                {#if manageMemberSubmitting}
                  <span class="spinner-xs"></span>
                  <span>Salvando...</span>
                {:else}
                  <Check size={15} />
                  <span>Salvar Alteraes</span>
                {/if}
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>

