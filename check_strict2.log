                manageMemberError = result.data?.message || 'Erro ao atualizar membro.';
              } else if (result.type === 'success') {
                if (result.data?.requiresConfirmation) {
                  manageMemberWarning = (result.data as any)?.warning;
                } else {
                  editingMember = null;
                  await update();
                }
              }
            };
          }}
